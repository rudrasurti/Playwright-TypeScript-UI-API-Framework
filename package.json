{
  "name": "playwright-typescript-ui-api-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript framework for UI and API testing with Page Object Model and CI",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "lint": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "author": "Rudra Surti",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
